# Real KWin, portals, PipeWire and AT-SPI, for the driver's end-to-end checks. No Rust: binaries are mounted.
FROM docker.io/library/ubuntu:26.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    kwin-wayland kwin-common libkf6service-bin libkscreen-bin xdg-desktop-portal xdg-desktop-portal-kde \
    at-spi2-core libatk-adaptor dbus dbus-x11 libglib2.0-bin fuse3 xwayland pipewire pipewire-bin wireplumber \
    libgl1-mesa-dri libegl-mesa0 libgbm1 mesa-vulkan-drivers libglx-mesa0 qt6-wayland libxcb-cursor0 \
    python3-gi gir1.2-atspi-2.0 gir1.2-gtk-3.0 gir1.2-gtk-4.0 python3-dbus python3-pil python3-pyqt6 libcap2-bin fonts-dejavu-core \
    libkf5service-data libpipewire-0.3-0t64 libei1 libxkbcommon0 libdbus-1-3
# What Chrome needs. The keys check mounts a Chrome install from the host when asked to.
RUN apt-get install -y --no-install-recommends libnss3 libnspr4 libatk-bridge2.0-0t64 libatk1.0-0t64 libasound2t64 libcups2t64 \
    libpango-1.0-0 libcairo2 libxcomposite1 libxdamage1 libxrandr2 libdrm2 libvulkan1 fonts-liberation
# Real-time priority needs a capability that a rootless container lacks.
RUN setcap -r /usr/bin/kwin_wayland; true
COPY plasma-applications.menu /etc/xdg/menus/plasma-applications.menu
COPY plasma-applications.menu /etc/xdg/menus/applications.menu
